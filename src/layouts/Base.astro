---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import { SITE, NAV, url } from '../site';

interface Props {
  title?: string;
  description?: string;
  /** Header sits transparently over a dark photo hero. */
  overlay?: boolean;
}
const {
  title,
  overlay = false,
  description = 'Ture Aid is an on-device assistant for New Zealand criminal defence barristers. It files email into matters, reads scans and photos locally, replaces identifying details with placeholders and proposes dates with sources. It never writes legal text.',
} = Astro.props;
const fullTitle = title ? `${title} · Ture Aid` : 'Ture Aid · On-device assistant for NZ criminal defence barristers';
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname.slice(basePath.length).replace(/\.html$/, '').replace(/\/index$/, '/') || '/';
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<!doctype html>
<html lang="en-NZ">
  <head>
    <meta charset="utf-8" />
    <!-- Lets CSS hide scroll-reveal elements only when JS is running, so content never stays hidden. -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <meta name="theme-color" content="#0b1f2a" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class:list={["site-header", { overlay }]}>
      <div class="wrap bar">
        <a class="brand" href={url('/')} aria-label="Ture Aid home">
          <Logo size={34} />
          <span class="word">TURE AID</span>
        </a>
        <nav aria-label="Main">
          <ul>
            {NAV.map((item) => (
              <li>
                <a href={url(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
              </li>
            ))}
          </ul>
        </nav>
        <a class="btn btn-pop nav-cta" href={url('/waitlist')}>Join the waitlist</a>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap foot">
        <div class="foot-top">
          <div class="foot-brand">
            <div class="brand">
              <Logo size={28} fg="#ffffff" accent="var(--aqua-soft)" />
              <span class="word">TURE AID</span>
            </div>
            <p>{SITE.tagline} · {SITE.status} · {SITE.platform}</p>
          </div>
          <nav aria-label="Footer">
            <ul>
              {NAV.map((item) => <li><a href={url(item.href)}>{item.label}</a></li>)}
              <li><a href={url('/waitlist')}>Join the waitlist</a></li>
            </ul>
          </nav>
        </div>
        <div class="foot-bottom">
          <p class="fine">
            Ture Aid never writes legal text and is not legal advice. Everything it proposes is for you to check.
            Sample data in the beta is invented.
          </p>
          <p class="fine">Photography from Unsplash.</p>
        </div>
      </div>
    </footer>
    <script>
      // Scroll reveal: fade elements up as they enter the viewport, staggering siblings.
      const selectors = [
        '.section-head', '.features li', '.photo', '.steps li', '.pipeline li', '.private > div',
        '.grid > *', '.two > *', '.person', '.entry', '.mark-note', '.faq details',
        '.never-grid > *', '.cta-inner > *', '.expect li', '.form', '.ways > *', '.roles > li',
      ].join(',');
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const els = Array.from(document.querySelectorAll<HTMLElement>(selectors));

      if (reduce || !('IntersectionObserver' in window)) {
        els.forEach((el) => el.classList.add('in'));
      } else {
        els.forEach((el) => {
          el.classList.add('reveal');
          const siblings = el.parentElement ? Array.from(el.parentElement.children).filter((c) => c.matches(selectors)) : [];
          const i = Math.max(0, siblings.indexOf(el));
          el.style.setProperty('--d', `${Math.min(i, 5) * 90}ms`);
        });
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('in');
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -4% 0px', threshold: 0.04 },
        );
        els.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute; left: 12px; top: -60px; z-index: 10;
    background: var(--ink); color: var(--white); padding: 10px 14px; border-radius: 8px;
  }
  .skip:focus { top: 12px; }

  .site-header {
    position: sticky; top: 0; z-index: 5;
    background: rgba(246, 244, 239, 0.9);
    backdrop-filter: saturate(1.4) blur(12px);
    border-bottom: 1px solid var(--line);
  }
  /* Over a photo hero: transparent, white type, pulled up over the hero */
  .site-header.overlay {
    position: absolute; left: 0; right: 0;
    background: linear-gradient(rgba(8, 22, 30, 0.55), rgba(8, 22, 30, 0));
    backdrop-filter: none; border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }
  .site-header.overlay .brand { color: var(--white); }
  .site-header.overlay :global(.logo-mark path),
  .site-header.overlay :global(.logo-mark line) { stroke: var(--white); }
  .site-header.overlay :global(.logo-mark line) { stroke: var(--aqua-soft); }
  .site-header.overlay .bar nav a { color: rgba(255, 255, 255, 0.82); }
  .site-header.overlay .bar nav a:hover,
  .site-header.overlay .bar nav a[aria-current='page'] { color: var(--white); background: rgba(255, 255, 255, 0.1); }

  .bar { display: flex; align-items: center; gap: 24px; min-height: 76px; flex-wrap: wrap; padding-top: 8px; padding-bottom: 8px; }
  .brand { display: inline-flex; align-items: center; gap: 12px; text-decoration: none; color: var(--ink); }
  .word { font-weight: 550; letter-spacing: 0.24em; font-size: 0.95rem; }
  nav ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 2px; }
  .bar nav { margin-left: auto; }
  .bar nav a {
    display: inline-flex; align-items: center; min-height: 44px; padding: 0 14px; border-radius: 999px;
    text-decoration: none; color: var(--ink-2); font-weight: 500; font-size: 0.95rem;
  }
  .bar nav a:hover { background: var(--stone); color: var(--ink); }
  .bar nav a[aria-current='page'] { color: var(--ink); background: var(--stone); }
  .nav-cta { min-height: 44px; padding: 10px 20px; font-size: 0.92rem; }

  @media (max-width: 860px) {
    .bar nav { order: 3; margin-left: 0; width: 100%; overflow-x: auto; }
    .bar nav ul { flex-wrap: nowrap; }
    .nav-cta { margin-left: auto; }
  }

  .site-footer { background: var(--ink); color: #c8d6da; padding: 40px 0 28px; }
  .foot { display: flex; flex-direction: column; gap: 28px; }
  .foot-top { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px 40px; }
  .foot-brand { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 20px; }
  .foot .brand { color: var(--white); }
  .foot-brand p { font-size: 0.88rem; color: #a9bcc2; }
  .foot nav ul { gap: 4px 24px; }
  .foot nav a { color: var(--white); text-decoration: none; font-size: 0.93rem; }
  .foot nav a:hover { color: var(--aqua); }
  .foot-bottom { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 32px; padding-top: 20px; border-top: 1px solid rgba(255, 255, 255, 0.1); }
  .fine { color: #8fa5ac; font-size: 0.82rem; }
</style>
